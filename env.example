# API Configuration
API_VERSION=1.0.0
API_TITLE=Docling OCR API
API_DESCRIPTION=API for converting documents to Markdown using Docling
API_PREFIX=/ocr/docling

# Server Configuration
HOST=0.0.0.0
PORT=8002
WORKERS=4
LOG_LEVEL=info

# File Upload Limits
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
MAX_FILES_IN_ARCHIVE=100
TEMP_FILES_TTL=3600  # Temp file TTL in seconds

# Docling Configuration
DOCLING_ARTIFACTS_PATH=./models  # Path to Docling models
DOCLING_PIPELINE_MODE=standard  # standard or vlm

# OCR Configuration (Standard Pipeline)
DOCLING_OCR_ENABLED=true
DOCLING_OCR_ENGINE=easyocr  # easyocr, tesseract, rapidocr
DOCLING_OCR_LANGUAGES=en,ru
DOCLING_OCR_GPU=false  # Enable GPU acceleration for EasyOCR
DOCLING_OCR_FORCE_FULL_PAGE=false  # Force full-page OCR even for digital PDFs

# Table Processing
DOCLING_TABLE_MODE=accurate  # fast or accurate
DOCLING_TABLE_CELL_MATCHING=true

# VLM Configuration (VLM Pipeline - inactive by default)
DOCLING_VLM_ENABLED=false
DOCLING_VLM_API_URL=http://localhost:8000/v1/chat/completions
DOCLING_VLM_API_KEY=not-needed
DOCLING_VLM_MODEL=qwen-vl-3b
DOCLING_VLM_TIMEOUT=90
DOCLING_VLM_TEMPERATURE=0.0
DOCLING_VLM_MAX_TOKENS=4096
DOCLING_VLM_RESPONSE_FORMAT=markdown  # markdown, html, doctags
DOCLING_VLM_PROMPT=Convert this page to docling.

# Archive Processing
PRESERVE_STRUCTURE=true
EXTRACT_TIMEOUT=300  # Archive extraction timeout in seconds

# Output Configuration
DEFAULT_OUTPUT_FORMAT=markdown  # markdown, html, json, doctags
ENABLE_CHUNKING=false  # Enable document chunking for RAG
CHUNK_SIZE=1000  # Characters per chunk
CHUNK_OVERLAP=200  # Overlap between chunks

# Advanced Features
ENABLE_TABLE_EXTRACTION=true
ENABLE_VISUAL_GROUNDING=false  # Include bounding boxes in output
ENABLE_METADATA_EXTRACTION=true

