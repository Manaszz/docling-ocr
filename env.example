# API Configuration
API_VERSION=1.2.0
API_TITLE=Docling OCR API
API_DESCRIPTION=API for converting documents to Markdown using Docling
API_PREFIX=/ocr/docling

# Localization
DEFAULT_LANGUAGE=ru  # ru (Russian) or en (English) - default language for UI

# Server Configuration
HOST=0.0.0.0
PORT=8002
WORKERS=4
LOG_LEVEL=info

# File Upload Limits
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
MAX_FILES_IN_ARCHIVE=100
TEMP_FILES_TTL=3600  # Temp file TTL in seconds

# Docling Configuration
DOCLING_ARTIFACTS_PATH=./models  # Path to Docling models
DOCLING_PIPELINE_MODE=standard  # standard or vlm

# OCR Configuration (Standard Pipeline)
DOCLING_OCR_ENABLED=true
DOCLING_OCR_ENGINE=easyocr  # easyocr, tesseract, rapidocr
DOCLING_OCR_LANGUAGES=en,ru
DOCLING_OCR_GPU=false  # Enable GPU acceleration for OCR
DOCLING_OCR_FORCE_FULL_PAGE=false  # Force full-page OCR even for digital PDFs

# RapidOCR Configuration (when DOCLING_OCR_ENGINE=rapidocr)
# RapidOCR uses PaddleOCR PP-OCRv4 models in ONNX format
DOCLING_RAPIDOCR_BACKEND=onnxruntime  # onnxruntime (CPU) or torch (GPU)
DOCLING_RAPIDOCR_MODELS_PATH=/root/.cache/rapidocr/models  # Path to pre-downloaded models
DOCLING_RAPIDOCR_TEXT_SCORE=0.5  # Confidence threshold (0.0-1.0)

# Table Processing
DOCLING_TABLE_MODE=accurate  # fast or accurate
DOCLING_TABLE_CELL_MATCHING=true

# VLM Configuration (VLM Pipeline - inactive by default)
# Supports OpenAI-compatible APIs: vLLM, Ollama, OpenRouter, etc.
DOCLING_VLM_ENABLED=false
DOCLING_VLM_API_URL=http://localhost:8000/v1/chat/completions
DOCLING_VLM_API_KEY=not-needed
DOCLING_VLM_MODEL=qwen-vl-3b
DOCLING_VLM_TIMEOUT=90
DOCLING_VLM_TEMPERATURE=0.0
DOCLING_VLM_MAX_TOKENS=4096
DOCLING_VLM_RESPONSE_FORMAT=markdown  # markdown, html, doctags
DOCLING_VLM_PROMPT=Convert this page to docling.

# Example: PaddleOCR-VL Configuration (recommended for document parsing)
# DOCLING_VLM_ENABLED=true
# DOCLING_VLM_API_URL=http://your-vllm-server:8080/v1/chat/completions
# DOCLING_VLM_API_KEY=your-api-key
# DOCLING_VLM_MODEL=PaddleOCR-VL-0.9B
# DOCLING_VLM_PROMPT=OCR:
# DOCLING_VLM_TIMEOUT=120
# PaddleOCR-VL prompts: OCR: | Table Recognition: | Formula Recognition: | Chart Recognition:

# Archive Processing
PRESERVE_STRUCTURE=true
EXTRACT_TIMEOUT=300  # Archive extraction timeout in seconds

# Output Configuration
DEFAULT_OUTPUT_FORMAT=markdown  # markdown, html, json, doctags
ENABLE_CHUNKING=false  # Enable document chunking for RAG
CHUNK_SIZE=1000  # Characters per chunk
CHUNK_OVERLAP=200  # Overlap between chunks

# Chunking Configuration
# Chunking mode: 0=simple (character-based), 1=hierarchical (semantic), 2=hybrid (hierarchical + tokens)
CHUNKING_MODE=0
# Maximum tokens per chunk for hybrid mode (mode=2). Used when max_tokens not specified in API request
CHUNKING_MAX_TOKENS=512
# Merge list items into single chunk for hierarchical mode (mode=1)
CHUNKING_MERGE_LIST_ITEMS=true
# Merge peer chunks in same section for hybrid mode (mode=2)
CHUNKING_MERGE_PEERS=true

# Advanced Features
ENABLE_TABLE_EXTRACTION=true
ENABLE_VISUAL_GROUNDING=false  # Include bounding boxes in output
ENABLE_METADATA_EXTRACTION=true

